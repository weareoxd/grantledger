# Copy to .env and fill in (`make setup` does this, with generated secrets). App settings are
# validated at startup by src/lib/env.ts; the POSTGRES_* values are only read by Docker Compose.

# --- Database ---------------------------------------------------------------
# Used by the web app, the worker, migrations and scripts. URL-encode special characters in the
# password. Inside Docker (`make prod-up`) the host is "postgres" instead of localhost:5434.
DATABASE_URL=postgres://grantledger:grantledger@localhost:5434/grantledger
# Every table goes in the "grantledger" schema (src/lib/db/schema-name.ts), which the migrations
# create. A hosted database may also pass the two below.
#   DATABASE_SCHEMA=grantledger
#   DATABASE_PGSSLCA_BASE64=<the server's CA bundle, base64>: connect over TLS, checked against it
# A database the tests may empty (its name must contain "test"); created on first use.
DATABASE_URL_TEST=postgres://grantledger:grantledger@localhost:5434/test_grantledger
# The local postgres container (docker-compose.yml)
POSTGRES_DB=grantledger
POSTGRES_USER=grantledger
POSTGRES_PASSWORD=grantledger
# The database `make prod-up` gives the production image, when DATABASE_URL above names another
# database than POSTGRES_DB. Keep the two in step.
# APP_DATABASE_NAME=grantledger
# 5432 and 5433 are often taken by other projects' databases
POSTGRES_HOST_PORT=5434

# --- Web UI sign-in (Better Auth, with Google) ------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public origin (cookies and CSRF). The Google OAuth client (below) must list
#   <BETTER_AUTH_URL>/api/auth/callback/google
# as an authorized redirect URI.
BETTER_AUTH_URL=http://localhost:3000
# The admin's Google email: their account is created (as an admin) on startup. Anyone else with a
# Google account can sign in, as a user; admins promote people in Admin > Users, or with
# `make user EMAIL=... ROLE=admin`.
ADMIN_EMAIL=
# Comma-separated IPs/CIDRs of the reverse proxy in front of the app. Its X-Forwarded-For is used
# for rate limiting. Only expose the app port to that proxy.
TRUSTED_PROXIES=

# --- MCP server (read-only LLM access at /api/mcp) --------------------------
# Static bearer token for programmatic clients (Claude Code, Claude Desktop).
# Generate with: openssl rand -base64 32
MCP_API_KEY=
# Hard cap on rows returned by one tool call. Blank, "none", "null" or 0 for unlimited.
MCP_MAX_ROWS=500
# Longest one tool call's query may run, in ms (the database is shared); 0 for no limit.
MCP_STATEMENT_TIMEOUT_MS=60000
# MCP OAuth (Google federation), for the claude.ai / ChatGPT connectors. Leave MCP_PUBLIC_URL
# blank to turn OAuth off (static bearer only). When set it must be this server's public https
# origin, and the Google OAuth client must list
#   <MCP_PUBLIC_URL>/api/mcp-oauth/google/callback
# as an authorized redirect URI.
MCP_PUBLIC_URL=
# Signs the OAuth access and refresh tokens. Generate with: openssl rand -base64 48
MCP_JWT_SECRET=
# Optional allowlist of Google email domains for the connectors (space- or comma-separated).
MCP_ALLOWED_EMAIL_DOMAINS=
# The Google OAuth web client, for web UI sign-in and the MCP connectors' OAuth. Its authorized
# redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google, and with MCP OAuth on,
# <MCP_PUBLIC_URL>/api/mcp-oauth/google/callback.
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
# Token lifetimes: access in seconds, refresh in days
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL_DAYS=30

# --- Worker -----------------------------------------------------------------
# Where downloaded files are kept (the federal file is about 2.3 GB)
DATA_DIR=./data
# When each source is downloaded (cron, in TZ). Unchanged files are skipped.
ALBERTA_LIVE_CRON=0 6 * * *
# The federal file (about 2.3 GB) is only downloaded and imported when this is true, on its
# schedule or from the Worker page. Off by default; federal rows already imported stay.
FEDERAL_IMPORTS_ENABLED=false
FEDERAL_CRON=0 3 * * 1
# Keep individuals' names instead of withholding them (private copies only)
IMPORT_INCLUDE_INDIVIDUALS=false
# The sources (defaults: the governments' published URLs; override to test against a mirror)
# ALBERTA_LIVE_URL=https://grants.dataservices.alberta.ca/GrantsDataService.svc/file.exportcsv
# ALBERTA_ARCHIVE_BASE=https://open.alberta.ca/dataset/faef5592-9ea0-4b60-92db-79a8a9673fe5/resource
# FEDERAL_GRANTS_URL=https://open.canada.ca/data/dataset/432527ab-7aac-45b5-81d6-7597107a7013/resource/1d15a62f-5656-49ad-8c88-f40ce689d831/download/grants.csv

# --- JSON API limits ----------------------------------------------------------
# Rows in one CSV export (Excel's sheet limit is 1,048,576 rows, header included)
API_EXPORT_MAX_ROWS=1048575
# The web server's result cache (pages, totals, summaries), in MB of memory. The container
# shares its memory with the worker (512 MiB is enough for both), so keep this well below that.
CACHE_MAX_MB=64
# Per-request database limits for lists, and for the overview pages' figures
API_STATEMENT_TIMEOUT_MS=15000
API_WORK_MEM=32MB
API_SUMMARY_TIMEOUT_MS=60000

# --- Runtime ----------------------------------------------------------------
PORT=3000
TZ=America/Edmonton
LOG_LEVEL=info
# Apply pending database migrations on startup (web app and worker)
RUN_MIGRATIONS=true
# Where the SQL migrations live. Defaults to ./drizzle (the images set /app/drizzle).
# MIGRATIONS_DIR=drizzle
