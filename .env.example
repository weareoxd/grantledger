# Copy this file to .env for local development (docker compose reads it).

# Django
SECRET_KEY=change-me-generate-with-get_random_secret_key
SITE_NAME=GrantLedger
DEBUG=true
DJANGO_CONFIGURATION=Local
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Database (django service -> postgres service)
DB_DATABASE=grantledger
DB_USER=grantledger
DB_PASSWORD=grantledger
DB_HOST=postgres
DB_PORT=5432

# Postgres image
POSTGRES_DB=grantledger
POSTGRES_USER=grantledger
POSTGRES_PASSWORD=grantledger

# MCP server (read-only LLM access)
# Static bearer token for programmatic MCP clients (Claude Code / Claude Desktop) at /mcp.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_API_KEY=
# Hard cap on rows returned by any single MCP tool call (default 500).
# Leave blank, or set "none"/"null"/0, for unlimited.
MCP_MAX_ROWS=500

# MCP OAuth (Google federation) - enables the claude.ai / ChatGPT connectors.
# Leave MCP_PUBLIC_URL blank to disable OAuth (static bearer only). When set it must be
# this server's public https origin, and the Google OAuth client must list
# <MCP_PUBLIC_URL>/mcp-oauth/google/callback as an authorized redirect URI.
MCP_PUBLIC_URL=
# Optional app-side allowlist of Google email domains (space-separated).
MCP_ALLOWED_EMAIL_DOMAINS=
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_PROJECT_ID=
