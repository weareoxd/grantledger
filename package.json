{
  "name": "grantledger",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker:dev\"",
    "build": "next build && npm run build:scripts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project ui",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx -y auth@1.7.7 generate --config better-auth.config.ts --output src/lib/db/auth-schema.ts -y && node scripts/auth-schema-in-app-schema.mjs && biome check --write src/lib/db/auth-schema.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "users": "tsx scripts/users.ts",
    "import": "tsx scripts/import.ts",
    "rollup": "tsx scripts/rollup.ts",
    "stats": "tsx scripts/stats.ts",
    "mcp-call": "tsx scripts/mcp-call.ts",
    "mcp-stdio": "tsx scripts/mcp-stdio.ts",
    "question-bank": "tsx scripts/run-question-bank.ts"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.8",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "croner": "^10.0.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.12",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pg-query-stream": "^4.17.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@vitest/mocker": {
      "msw": "$msw"
    }
  }
}
